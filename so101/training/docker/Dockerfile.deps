# syntax=docker/dockerfile:1
# Heavy CUDA deps image: OS + uv + torch/lerobot wheels.
# Rebuild and push only when pyproject.toml / uv.lock (or this file) change.
#
#   bash training/scripts/build_docker.sh --target deps --push
#
# Build linux/amd64 (Nebius L40S/H100). Pass --platform on `docker build`, not FROM.

FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04 AS cuda-base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    build-essential \
    python3-dev \
    pkg-config \
    git \
    ffmpeg \
    libevdev-dev \
    libavformat-dev \
    libavcodec-dev \
    libavdevice-dev \
    libavutil-dev \
    libswscale-dev \
    libswresample-dev \
    libavfilter-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

FROM cuda-base AS deps

WORKDIR /lerobot
RUN mkdir -p outputs

COPY pyproject.toml uv.lock ./

ENV UV_INDEX_STRATEGY=unsafe-best-match
ENV UV_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cu128
ENV UV_HTTP_TIMEOUT=120
ENV UV_HTTP_RETRIES=5
ENV UV_PROJECT_ENVIRONMENT=/lerobot/.venv
ENV TRAIN_DEVICE=cuda

RUN --mount=type=cache,target=/root/.cache/uv \
    uv python install 3.12 && \
    uv venv --python 3.12 .venv && \
    uv sync --frozen --no-install-project --no-dev --python 3.12 --index-strategy unsafe-best-match

ENV VIRTUAL_ENV=/lerobot/.venv
ENV PATH="/lerobot/.venv/bin:$PATH"
