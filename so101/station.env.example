# Copy to so101/station.env and fill in after listing USB ports.
# Hardware + this station's task only. Hub user/dataset live in the repo-root `.env`.
# From so101: set -a && source ../.env && source station.env && set +a

# USB serial ports (macOS: /dev/tty.usbmodem...  Linux: /dev/ttyACM0)
FOLLOWER_PORT=/dev/tty.usbmodem0000001
LEADER_PORT=/dev/tty.usbmodem0000002

# Calibration keys — reuse the same ids for teleop, record, replay, and rollout
FOLLOWER_ID=pizza_follower
LEADER_ID=pizza_leader

# RGB cameras (640x480 @ 30 FPS). Keys become observation.images.front / .top
CAMERA_INDEX=0
# Overhead table camera. Leave empty for front-only. Must differ from CAMERA_INDEX.
CAMERA_INDEX_TOP=
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# What this station records / rolls out (exact sentence is part of the dataset)
TASK="Pick a pepperoni token and place it on the pizza."
NUM_EPISODES=50
EPISODE_TIME_S=30
RESET_TIME_S=10
